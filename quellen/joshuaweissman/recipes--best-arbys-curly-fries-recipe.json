      "ingredients": [
        "Spiralizer",
        "3 russet potatoes",
        "2.5 qt (2.25 liters) warm water",
        "2.5 Tbsp (25g) kosher salt",
        "Neutral oil for frying",
        "½ cup (80g) all purpose flour",
        "2 tsp (8g) kosher salt",
        "2 Tbsp (24g) smoked paprika",
        "2 Tbsp (19g) ancho powder",
        "½ tsp (1g) cayenne",
        "½ Tbsp (7g) garlic powder",
        "1 cup (240ml) water",
        "¼ cup (60g) mayonnaise",
        "½ (17g) small grated black winter truffle",
        "2 cloves garlic, grated",
        "1 small bunch chives finely chopped",
        "Splash fish sauce",
        "Black pepper to taste"
      ],
      "instructions": [
        "Start by spiralizing the skin-on russet potatoes. Cover the spirals with water and kosher salt. Stir to combine and soak for 30 minutes.",
        "For the batter, whisk and combine all dry ingredients before carefully whisking in water.",
        "Fill a heavy bottom pot with frying oil and heat to 350℉.",
        "Remove fries from soaking liquid, cut and toss into the batter.",
        "Carefully fry in batches for 4-5 minutes and set on a wire rack set in a baking sheet and immediately season with salt"
      ],
