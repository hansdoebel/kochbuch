{
  "name": "@kochbuch/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && bun scripts/precompress.ts && bun scripts/check-bundle.ts",
    "start": "bun src/server/index.ts",
    "check": "bun run format:check && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "setup:typst": "bun scripts/install-typst.ts",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.ts\" \"*.js\""
  },
  "dependencies": {
    "@lucide/svelte": "1.76.0",
    "bits-ui": "2.21.0",
    "clsx": "2.1.1",
    "svelte": "5.58.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/svelte": "5.0.9",
    "@types/bun": "1.4.4",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "packageManager": "bun@1.4.5"
}
