        {
          "tag": "p",
          "text": "Burger:"
        },
        {
          "tag": "li",
          "text": "Preheat your smoker to 225°F."
        },
        {
          "tag": "li",
          "text": "Shape each portion into a patty, about 1/2 inch thick."
        },
        {
          "tag": "li",
          "text": "Place the patty on the smoker grates and smoke for about 1-1.5 hours, or until they reach an internal temperature of 160°F."
        },
        {
          "tag": "li",
          "text": "Remove the patties from the smoker and let them rest for a few minutes before serving."
        },
        {
          "tag": "li",
          "text": "Add a slice of cheese on the patty and use a torch or oven to melt the cheese."
        },
        {
          "tag": "p",
          "text": "Burger Sauce:"
        },
        {
          "tag": "li",
          "text": "In a small bowl combine all ingredients. Use a whisk to mix thoroughly."
        },
