{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": { "$lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.svelte", "src/**/*.ts", "vite.config.ts"],
  "exclude": ["src/server", "tests", "scripts"]
}
