          "tag": "p",
          "text": "Assembly:"
        },
        {
          "tag": "li",
          "text": "Toast buns."
        },
        {
          "tag": "li",
          "text": "Place the bun heel on plate."
        },
        {
          "tag": "li",
          "text": "Spread the sauce on the top half of the bun."
