      "instruction_sections": [
        {
          "tag": "p",
          "text": "Chicken:"
        },
        {
          "tag": "li",
          "text": "Start by pounding the chicken just to flatten thighs."
        },
        {
          "tag": "li",
          "text": "For the seasoning, mix all dry ingredients together until combined."
        },
        {
          "tag": "li",
          "text": "Season with all seasoning. Ideally, cure in a bag overnight."
        },
        {
          "tag": "li",
          "text": "Grill till done, finish with lime juice."
        },
        {
          "tag": "p",
          "text": "‍Vegetable:"
        },
        {
          "tag": "li",
          "text": "Start by slicing the vegetables."
        },
        {
          "tag": "li",
          "text": "Sear vegetables aggressively in a pan, finish with garlic (gently)"
        },
        {
          "tag": "p",
          "text": "‍Beans:"
        },
        {
          "tag": "li",
          "text": "Seed tomatoes then roughly chop them with a knife"
        },
        {
          "tag": "li",
          "text": "Cook-off chorizo, add vegetable oil if needed"
        },
        {
          "tag": "li",
          "text": "Add onion, jalapeno, and garlic, saute till softened, add in tomatoes saute till softened"
        },
        {
          "tag": "li",
          "text": "Add in cumin and chicken stock. Bring to a boil and reduce by about ¼"
        },
        {
          "tag": "li",
          "text": "Add beans and continue to cook till hot."
        },
        {
          "tag": "p",
          "text": "Mexican Rice:"
        },
        {
          "tag": "li",
          "text": "Cook garlic for 3 minutes"
        },
        {
          "tag": "li",
          "text": "Add rice and toast for about 5 minutes and add remaining ingredients."
        },
        {
          "tag": "li",
          "text": "Pour into a rice cooker for about 20 minutes."
        }
