        "2 jalapenos, finely chopped",
        "2 Tbsp (30g) capers, drained and finely chopped",
        "1 lime, zested and juiced",
        "2 cloves garlic, grated",
        "3 Tbsp (45g) toasted sesame seeds",
        "½ cup (120mL) extra-virgin olive oil",
        "Kosher salt, to taste"
      ],
