      "instruction_sections": [
        {
          "tag": "p",
          "text": "Burger:"
        },
        {
          "tag": "li",
          "text": "Preheat your grill or skillet to medium-high heat."
        },
        {
          "tag": "li",
          "text": "Weigh your portion of ground beef and shape into a patty. Season both sides of the patty with salt and pepper."
        },
        {
          "tag": "li",
          "text": "Place the patty in the skillet and cook for 3 minutes, and flip."
        },
        {
          "tag": "li",
          "text": "Cook for 3 minutes and turn off heat. Add butter, garlic, and thyme. Use a spoon to baste the patty with the butter."
        },
        {
          "tag": "li",
          "text": "During the last minute of cooking, add a slice of cheese to the patty and let it melt."
        },
        {
          "tag": "li",
          "text": "Take the patty out of the pan and rest on a wire rack."
        },
        {
          "tag": "p",
          "text": "Assembly:"
        },
        {
          "tag": "li",
          "text": "Toast buns."
        },
        {
          "tag": "li",
          "text": "Spread the sauce on the bottom half of each bun."
        },
        {
          "tag": "li",
          "text": "Add a patty with melted cheese on top."
        },
        {
          "tag": "li",
          "text": "Add lettuce, tomato, and onion."
        },
        {
          "tag": "li",
          "text": "Spread mayo on the top bun."
        },
        {
          "tag": "li",
          "text": "Finish with the top half of the bun."
        }
