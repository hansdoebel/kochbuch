      "cook_time": null,
      "total_time": "PT30M",
      "ingredients": [
        "Für den Waffelteig:",
        "300 g Weizenmehl (Type 405)",
        "50 g brauner Zucker",
        "1 TL Backpulver",
        "8 g Vanillezucker",
        "200 ml pflanzliche Milch",
        "20 ml Pflanzenöl",
        "100 ml kohlensäurehaltiges Mineralwasser",
        "Prise Salz",
        "Außerdem:",
        "vegane Margarine zum Einfetten",
        "Toppings (z.B. Puderzucker, Früchte, vegane Schlagsahne etc.)"
      ],
      "instructions": [
        "Mehl, Zucker, Backpulver, Vanillezucker und Salz in einer großen Schüssel vermischen. Anschließend pflanzliche Milch, Pflanzenöl und Mineralwasser unterrühren.",
        "Das Waffeleisen erhitzen und mit etwas pflanzlicher Margarine einfetten.",
        "Den Teig nach und nach zu goldbraunen Waffeln verarbeiten und mit Toppings eurer Wahl servieren."
      ],
